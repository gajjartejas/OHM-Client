+fun resolveNodeExecutable(): String {
+    val nodeProperty = safeAppExtGet("NODE_EXECUTABLE", null)?.toString()
+    if (!nodeProperty.isNullOrEmpty() && File(nodeProperty).exists()) {
+        return nodeProperty
+    }
+    val nodeEnv = System.getenv("NODE_BINARY")
+    if (!nodeEnv.isNullOrEmpty() && File(nodeEnv).exists()) {
+        return nodeEnv
+    }
+    val standardPaths = listOf(
+        "/opt/homebrew/bin/node",
+        "/usr/local/bin/node",
+        "/usr/bin/node",
+        "/bin/node"
+    )
+    for (path in standardPaths) {
+        if (File(path).exists()) return path
+    }
+    val userHome = System.getProperty("user.home") ?: ""
+    if (userHome.isNotEmpty()) {
+        val nvmDir = File(userHome, ".nvm/versions/node")
+        if (nvmDir.exists() && nvmDir.isDirectory) {
+            val nvmNodes = nvmDir.listFiles()
+                ?.filter { it.isDirectory }
+                ?.map { File(it, "bin/node") }
+                ?.filter { it.exists() }
+                ?.sortedByDescending { it.parentFile.parentFile.name }
+            if (!nvmNodes.isNullOrEmpty()) {
+                return nvmNodes.first().absolutePath
+            }
+        }
+        val managerPaths = listOf(
+            "$userHome/.local/share/fnm/current/bin/node",
+            "$userHome/.fnm/current/bin/node",
+            "$userHome/.volta/bin/node",
+            "$userHome/.asdf/shims/node",
+            "$userHome/.nodenv/shims/node"
+        )
+        for (path in managerPaths) {
+            if (File(path).exists()) return path
+        }
+    }
+    return "node"
+}
